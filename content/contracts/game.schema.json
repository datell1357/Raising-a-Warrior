{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "content/contracts/game.schema.json",
  "title": "Game content snapshot schema",
  "type": "object",
  "required": [
    "snapshotId",
    "contentVersion",
    "offlineRewardCapSeconds",
    "baseline",
    "regions",
    "stages",
    "cells",
    "quests",
    "skills",
    "equipment",
    "summonPools",
    "storeProducts",
    "promotions",
    "localeCatalogs",
    "manifests",
    "releaseCandidates",
    "ownership"
  ],
  "additionalProperties": false,
  "properties": {
    "snapshotId": {
      "type": "string",
      "enum": [
        "launch",
        "d90"
      ]
    },
    "contentVersion": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "offlineRewardCapSeconds": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "baseline": {
      "$ref": "#/$defs/baseline"
    },
    "regions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/region"
      }
    },
    "stages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/stage"
      }
    },
    "cells": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/cell"
      }
    },
    "quests": {
      "$ref": "#/$defs/questGroups"
    },
    "skills": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/skill"
      }
    },
    "equipment": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/equipment"
      }
    },
    "summonPools": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/summonPool"
      }
    },
    "storeProducts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/storeProduct"
      }
    },
    "promotions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/promotion"
      }
    },
    "localeCatalogs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/localeCatalog"
      }
    },
    "manifests": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/manifestComponent"
      }
    },
    "releaseCandidates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/releaseCandidateComponent"
      }
    },
    "ownership": {
      "$ref": "#/$defs/ownership"
    }
  },
  "$defs": {
    "baselineCounts": {
      "type": "object",
      "required": [
        "launch",
        "scheduled",
        "total"
      ],
      "additionalProperties": false,
      "properties": {
        "launch": {
          "type": "integer",
          "minimum": 0
        },
        "scheduled": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "baselineScalar": {
      "type": "object",
      "required": [
        "slots",
        "rarities",
        "tiers"
      ],
      "additionalProperties": false,
      "properties": {
        "slots": {
          "type": "integer",
          "minimum": 0
        },
        "rarities": {
          "type": "integer",
          "minimum": 0
        },
        "tiers": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "baselineStore": {
      "type": "object",
      "required": [
        "freeDaily",
        "rewardedAds",
        "currencyProducts",
        "starterPack",
        "adRemoval"
      ],
      "additionalProperties": false,
      "properties": {
        "freeDaily": {
          "type": "integer",
          "minimum": 0
        },
        "rewardedAds": {
          "type": "integer",
          "minimum": 0
        },
        "currencyProducts": {
          "type": "integer",
          "minimum": 0
        },
        "starterPack": {
          "type": "integer",
          "minimum": 0
        },
        "adRemoval": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "baselinePromotion": {
      "type": "object",
      "required": [
        "launch",
        "scheduled",
        "total"
      ],
      "additionalProperties": false,
      "properties": {
        "launch": {
          "type": "integer",
          "minimum": 0
        },
        "scheduled": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "baseline": {
      "type": "object",
      "required": [
        "weeks",
        "launchBaseline",
        "questBaseline",
        "skills",
        "equipment",
        "store",
        "promotion",
        "locales",
        "roles",
        "devices"
      ],
      "additionalProperties": false,
      "properties": {
        "weeks": {
          "type": "integer",
          "const": 64
        },
        "launchBaseline": {
          "type": "string"
        },
        "questBaseline": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "type": "integer"
          }
        },
        "skills": {
          "$ref": "#/$defs/baselineCounts"
        },
        "equipment": {
          "$ref": "#/$defs/baselineScalar"
        },
        "store": {
          "$ref": "#/$defs/baselineStore"
        },
        "promotion": {
          "$ref": "#/$defs/baselinePromotion"
        },
        "locales": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "roles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "devices": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "region": {
      "type": "object",
      "required": [
        "id",
        "order",
        "stageIds"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "order": {
          "type": "integer",
          "minimum": 1
        },
        "stageIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "stage": {
      "type": "object",
      "required": [
        "id",
        "regionId",
        "order",
        "cellIds",
        "bossCellId"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "regionId": {
          "type": "string"
        },
        "order": {
          "type": "integer",
          "minimum": 1
        },
        "cellIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "bossCellId": {
          "type": "string"
        }
      }
    },
    "cell": {
      "type": "object",
      "required": [
        "id",
        "regionId",
        "stageId",
        "order",
        "rewardKey"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "regionId": {
          "type": "string"
        },
        "stageId": {
          "type": "string"
        },
        "order": {
          "type": "integer",
          "minimum": 1
        },
        "rewardKey": {
          "type": "string"
        }
      }
    },
    "questObjective": {
      "type": "object",
      "required": [
        "kind",
        "targetId",
        "targetAmount"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "ReachLevel",
            "ClearStage"
          ]
        },
        "targetId": {
          "type": [
            "string",
            "null"
          ]
        },
        "targetAmount": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        }
      }
    },
    "quest": {
      "type": "object",
      "required": [
        "id",
        "group",
        "sequence",
        "objective",
        "reward",
        "nextQuestId"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "group": {
          "type": "string",
          "enum": [
            "main",
            "daily",
            "weekly",
            "achievement",
            "tutorial"
          ]
        },
        "sequence": {
          "type": "integer",
          "minimum": 0
        },
        "objective": {
          "$ref": "#/$defs/questObjective"
        },
        "reward": {
          "$ref": "#/$defs/reward"
        },
        "nextQuestId": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "questGroups": {
      "type": "object",
      "required": [
        "main",
        "daily",
        "weekly",
        "achievement",
        "tutorial"
      ],
      "additionalProperties": false,
      "properties": {
        "main": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/quest"
          }
        },
        "daily": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/quest"
          }
        },
        "weekly": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/quest"
          }
        },
        "achievement": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/quest"
          }
        },
        "tutorial": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/quest"
          }
        }
      }
    },
    "skill": {
      "type": "object",
      "required": [
        "id",
        "phase",
        "rarity",
        "targetRule",
        "basePower",
        "powerPerLevel",
        "targetCount",
        "cooldownMs",
        "resourceCost",
        "learnCost",
        "upgradeCostCurveId",
        "unlock",
        "visualKey",
        "localizationKey"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "phase": {
          "type": "string",
          "enum": [
            "launch",
            "d90"
          ]
        },
        "rarity": {
          "type": "string",
          "enum": [
            "Common",
            "Fine",
            "Rare",
            "Epic",
            "Astral"
          ]
        },
        "targetRule": {
          "type": "string"
        },
        "basePower": {
          "type": "string",
          "pattern": "^-?(0|[1-9][0-9]*)$"
        },
        "powerPerLevel": {
          "type": "string",
          "pattern": "^-?(0|[1-9][0-9]*)$"
        },
        "targetCount": {
          "type": "integer",
          "minimum": 1
        },
        "cooldownMs": {
          "type": "integer",
          "minimum": 1
        },
        "resourceCost": {
          "type": "integer",
          "minimum": 0
        },
        "learnCost": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/currencyAmount"
          }
        },
        "upgradeCostCurveId": {
          "type": "string"
        },
        "unlock": {
          "type": "object",
          "required": [
            "kind"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "Always"
              ]
            }
          }
        },
        "visualKey": {
          "type": "string"
        },
        "localizationKey": {
          "type": "string"
        }
      }
    },
    "equipmentStats": {
      "type": "object",
      "required": [
        "attack",
        "health"
      ],
      "additionalProperties": false,
      "properties": {
        "attack": {
          "type": "string",
          "pattern": "^-?(0|[1-9][0-9]*)$"
        },
        "health": {
          "type": "string",
          "pattern": "^-?(0|[1-9][0-9]*)$"
        }
      }
    },
    "equipment": {
      "type": "object",
      "required": [
        "id",
        "slot",
        "rarity",
        "tier",
        "baseStats",
        "statGrowthCurveId",
        "fuseInputCount",
        "fuseOutputId",
        "visualKey",
        "localizationKey"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "slot": {
          "type": "string"
        },
        "rarity": {
          "type": "string",
          "enum": [
            "Common",
            "Fine",
            "Rare",
            "Epic",
            "Astral"
          ]
        },
        "tier": {
          "type": "integer",
          "minimum": 1
        },
        "baseStats": {
          "$ref": "#/$defs/equipmentStats"
        },
        "statGrowthCurveId": {
          "type": "string"
        },
        "fuseInputCount": {
          "type": "integer",
          "minimum": 0
        },
        "fuseOutputId": {
          "type": [
            "string",
            "null"
          ]
        },
        "visualKey": {
          "type": "string"
        },
        "localizationKey": {
          "type": "string"
        }
      }
    },
    "currencyAmount": {
      "type": "object",
      "required": [
        "currencyId",
        "amount"
      ],
      "additionalProperties": false,
      "properties": {
        "currencyId": {
          "type": "string",
          "enum": [
            "BrassCoin",
            "MoonShard",
            "StarSeal",
            "MetalFragment"
          ]
        },
        "amount": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        }
      }
    },
    "rewardItem": {
      "type": "object",
      "required": [
        "definitionId",
        "amount"
      ],
      "additionalProperties": false,
      "properties": {
        "definitionId": {
          "type": "string"
        },
        "amount": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "skillCopy": {
      "type": "object",
      "required": [
        "skillId",
        "amount"
      ],
      "additionalProperties": false,
      "properties": {
        "skillId": {
          "type": "string"
        },
        "amount": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "reward": {
      "type": "object",
      "required": [
        "currencies",
        "items",
        "skillCopies",
        "accountExp"
      ],
      "additionalProperties": false,
      "properties": {
        "currencies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/currencyAmount"
          }
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/rewardItem"
          }
        },
        "skillCopies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/skillCopy"
          }
        },
        "accountExp": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        }
      }
    },
    "summonPoolEntry": {
      "type": "object",
      "required": [
        "equipmentId"
      ],
      "additionalProperties": false,
      "properties": {
        "equipmentId": {
          "type": "string"
        },
        "weight": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        }
      }
    },
    "summonPool": {
      "type": "object",
      "required": [
        "id",
        "version",
        "startsAt",
        "endsAt",
        "costOne",
        "costTen",
        "entries",
        "guaranteedRarityOnTen",
        "pityAt",
        "pityRarity",
        "duplicateConversion"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "type": "integer",
          "minimum": 0
        },
        "startsAt": {
          "type": "string"
        },
        "endsAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "costOne": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/currencyAmount"
          }
        },
        "costTen": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/currencyAmount"
          }
        },
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/summonPoolEntry"
          }
        },
        "guaranteedRarityOnTen": {
          "type": "string"
        },
        "pityAt": {
          "type": "integer",
          "minimum": 0
        },
        "pityRarity": {
          "type": "string"
        },
        "duplicateConversion": {
          "type": "object"
        },
        "validationSecret": {
          "type": "string"
        }
      }
    },
    "eligibilityRule": {
      "type": "object",
      "required": [
        "kind"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "Always"
          ]
        }
      }
    },
    "storeProduct": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "storeProductId",
        "priceCurrency",
        "priceAmount",
        "reward",
        "dailyLimit",
        "startsAt",
        "endsAt",
        "eligibilityRule"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "FreeDaily",
            "RewardedAd",
            "SoftCurrency",
            "IapConsumable",
            "IapNonConsumable"
          ]
        },
        "storeProductId": {
          "type": [
            "string",
            "null"
          ]
        },
        "priceCurrency": {
          "type": [
            "string",
            "null"
          ]
        },
        "priceAmount": {
          "type": [
            "string",
            "null"
          ]
        },
        "reward": {
          "$ref": "#/$defs/reward"
        },
        "dailyLimit": {
          "type": [
            "integer",
            "null"
          ]
        },
        "startsAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "endsAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "eligibilityRule": {
          "$ref": "#/$defs/eligibilityRule"
        }
      }
    },
    "promotion": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "componentId",
        "startsAt",
        "endsAt"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "launch",
            "scheduled"
          ]
        },
        "componentId": {
          "type": "string"
        },
        "startsAt": {
          "type": "string"
        },
        "endsAt": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "localeCatalog": {
      "type": "object",
      "required": [
        "locale",
        "keyCount",
        "keys"
      ],
      "additionalProperties": false,
      "properties": {
        "locale": {
          "type": "string",
          "enum": [
            "ko",
            "en",
            "ja",
            "zh-CN",
            "zh-TW"
          ]
        },
        "keyCount": {
          "type": "integer",
          "minimum": 0
        },
        "keys": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "manifestComponent": {
      "type": "object",
      "required": [
        "id",
        "bundle",
        "sha256",
        "sizeBytes",
        "dependencies",
        "minAppBuild"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "bundle": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 0
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "minAppBuild": {
          "type": "string"
        }
      }
    },
    "releaseCandidateComponent": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "componentId",
        "sourceHash",
        "artifactHash"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "componentId": {
          "type": "string"
        },
        "sourceHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "artifactHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "ownershipRow": {
      "type": "object",
      "required": [
        "todo",
        "feature",
        "specs"
      ],
      "additionalProperties": false,
      "properties": {
        "todo": {
          "type": "string"
        },
        "feature": {
          "type": "string"
        },
        "specs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "ownership": {
      "type": "object",
      "required": [
        "requirements",
        "featureCount",
        "specCount",
        "features",
        "specs"
      ],
      "additionalProperties": false,
      "properties": {
        "requirements": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "featureCount": {
          "type": "integer",
          "minimum": 0
        },
        "specCount": {
          "type": "integer",
          "minimum": 0
        },
        "features": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "specs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
